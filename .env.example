# Server-only workbook location. Never place the workbook under public/.
ACCOUNTING_WORKBOOK_PATH=.secure-data/Accounting Codes FY27.xlsx

# In production, your SSO/reverse proxy must overwrite this header and strip
# any client-supplied value. The API rejects unauthenticated production calls.
PRF_IDENTITY_HEADER=x-authenticated-user-email
PRF_ALLOWED_EMAIL_DOMAINS=woodcraftrangers.org

# Public PowerForm URL. Query parameter names below must exactly match the
# recipient role and tab Data Labels configured in your DocuSign template.
DOCUSIGN_POWERFORM_URL=https://powerforms.docusign.net/6879450f-9b25-45b8-9a41-c259335640ac?env=na4&acct=c1761818-d175-4112-a5df-132f844004c7&accountId=c1761818-d175-4112-a5df-132f844004c7
DOCUSIGN_SIGNER_ROLE=Signer
DOCUSIGN_TAB_REQUESTER_NAME=Requester Name
DOCUSIGN_TAB_DISTRICT=District
DOCUSIGN_TAB_SCHOOL=School Name
DOCUSIGN_TAB_SITE_CODE=Site Code
DOCUSIGN_TAB_FUNDING_SOURCE=Funding Source Name
DOCUSIGN_TAB_REGION=Region Department
DOCUSIGN_TAB_DESCRIPTION=Purchase Description
DOCUSIGN_TAB_AMOUNT=Line Item Amount

# --- Sessions and the request store -------------------------------------------
# Signing key for session cookies. Required in production (32+ characters) — the
# server refuses to start without it, because a generated key would sign every
# session out on deploy and would differ between instances behind a balancer.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PRF_SESSION_SECRET=

# Where the JSON request store lives. Keep it outside public/ and off the
# repository; .secure-data/ is git-ignored. The seeded demo credentials are
# written beside it as seed-credentials.txt on first run.
PRF_STORE_PATH=.secure-data/prf-store.json

# Password sign-in is a development and demo path. In production identity comes
# from the SSO headers above and the login endpoint refuses to run unless this
# is deliberately set to true.
PRF_ALLOW_PASSWORD_LOGIN=false
